{
  "name": "@pi-harness/shared",
  "version": "0.1.0-alpha.0",
  "description": "Shared schemas, config, and TypeScript domain types for pi-harness.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amankumarsingh77/pi-harness.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/amankumarsingh77/pi-harness#readme",
  "bugs": {
    "url": "https://github.com/amankumarsingh77/pi-harness/issues"
  },
  "keywords": [
    "pi",
    "agent",
    "coding-agent",
    "orchestration",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
