{
  "name": "@pi-harness/pi-bridge",
  "version": "0.1.0-alpha.0",
  "description": "Provider and session bridge between pi-harness and the pi coding-agent SDK.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amankumarsingh77/pi-harness.git",
    "directory": "packages/pi-bridge"
  },
  "homepage": "https://github.com/amankumarsingh77/pi-harness#readme",
  "bugs": {
    "url": "https://github.com/amankumarsingh77/pi-harness/issues"
  },
  "keywords": [
    "pi",
    "agent",
    "coding-agent",
    "llm",
    "orchestration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./_test/fake-sdk": {
      "types": "./dist/_test/fake-sdk.d.ts",
      "default": "./dist/_test/fake-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
