{
  "name": "@pi-harness/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "bin": {
    "pi-harness": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@pi-harness/dashboard": "workspace:*",
    "@pi-harness/db": "workspace:*",
    "@pi-harness/orchestrator": "workspace:*",
    "@pi-harness/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
