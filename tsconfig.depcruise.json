{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/dashboard/*"],
      "@pi-harness/db": ["packages/db/src/index.ts"],
      "@pi-harness/pi-bridge": ["packages/pi-bridge/src/index.ts"],
      "@pi-harness/shared": ["packages/shared/src/index.ts"],
      "@pi-harness/subagents": ["subagents/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "subagents/**/*.ts"]
}
