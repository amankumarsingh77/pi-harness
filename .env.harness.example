# Required for the default phase config provider (crofai).
# Get a key at https://crof.ai.
CROFAI_API_KEY=

# Optional: required only if a phase is configured to use the opencode-go provider.
OPENCODE_API_KEY=

# Optional: required only if a phase is configured to use the anthropic provider.
ANTHROPIC_API_KEY=

# Web research provider for brainstorm.
# TinyFish is the default provider. Set TINYFISH_API_KEY to enable hosted
# search/fetch, or set PI_WEB_PROVIDER=searxng for the local compose fallback.
PI_WEB_PROVIDER=tinyfish
TINYFISH_API_KEY=

# Optional: SearXNG local fallback for brainstorm web research.
# Used only when PI_WEB_PROVIDER=searxng.
SEARXNG_URL=http://localhost:8888
# Set true only when intentionally using a public/manual SearXNG instance.
SEARXNG_ALLOW_PUBLIC=false

# Add others as needed:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
