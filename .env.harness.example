# Required for the default phase config (crofai / kimi-k2.6).
# Get a key at https://crof.ai.
CROFAI_API_KEY=

# Optional: required only if a phase is configured to use the opencode-go provider.
OPENCODE_API_KEY=

# Optional: required only if a phase is configured to use the anthropic provider.
ANTHROPIC_API_KEY=

# Optional: SearXNG web research for brainstorm.
# Default is the local compose service started by `pnpm search:up`.
SEARXNG_URL=http://localhost:8888
# Set true only when intentionally using a public/manual SearXNG instance.
SEARXNG_ALLOW_PUBLIC=false

# Add others as needed:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
