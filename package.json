{
  "name": "pi-harness",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@pi-harness/dashboard --filter=@pi-harness/orchestrator",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "podman compose up -d postgres",
    "db:down": "podman compose down",
    "search:up": "podman compose up -d searxng",
    "search:down": "podman compose stop searxng",
    "infra:up": "podman compose up -d postgres searxng",
    "infra:down": "podman compose down",
    "db:migrate": "pnpm --filter @pi-harness/db migrate",
    "db:generate": "pnpm --filter @pi-harness/db generate"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "js-yaml": "^4.1.1",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
