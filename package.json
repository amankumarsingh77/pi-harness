{
  "name": "pi-harness",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@pi-harness/dashboard --filter=@pi-harness/orchestrator",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "audit:dead": "knip",
    "audit:dupes": "jscpd --config .jscpd.json apps packages subagents",
    "audit:deps": "depcruise apps packages subagents --config .dependency-cruiser.mjs --output-type err",
    "audit:patterns": "ast-grep scan --config sgconfig.yml --globs '!**/test/**' --globs '!**/e2e/**' --globs '!**/*.test.ts' --globs '!**/*.test.tsx' --globs '!**/*.spec.ts' --globs '!**/*.spec.tsx' apps packages subagents",
    "audit:maintainability": "pnpm audit:dead && pnpm audit:dupes && pnpm audit:deps && pnpm audit:patterns",
    "quality": "pnpm typecheck && pnpm lint && pnpm audit:maintainability && pnpm test",
    "db:up": "podman compose up -d postgres",
    "db:down": "podman compose down",
    "search:up": "podman compose up -d searxng",
    "search:down": "podman compose stop searxng",
    "infra:up": "podman compose up -d postgres searxng",
    "infra:down": "podman compose down",
    "db:migrate": "pnpm --filter @pi-harness/db migrate",
    "db:generate": "pnpm --filter @pi-harness/db generate"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.7.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jscpd": "^4.2.2",
    "knip": "^6.14.1",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3"
  }
}
